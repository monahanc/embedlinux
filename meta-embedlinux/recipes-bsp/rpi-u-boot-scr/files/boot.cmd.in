# Read base kernel command line provided by RPi GPU firmware (from cmdline.txt)
fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

# Initialize RAUC U-Boot slot selection defaults if unset
test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B"
test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3
test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3

# Select highest-priority RAUC slot with remaining boot attempts
# MBR partition layout:
#   p1: boot  (vfat)
#   p2: fita  (raw FIT image -> RAUC slot kernel.0)
#   p3: fitb  (raw FIT image -> RAUC slot kernel.1)
#   p4: extended partition container
#   p5: roota (ext4 -> RAUC slot rootfs.0, bootname=A)
#   p6: rootb (ext4 -> RAUC slot rootfs.1, bootname=B)
#   p7: data  (ext4 -> persistent /data, rauc.status)
setenv rauc_slot
setenv fit_part
setenv root_part
for BOOT_SLOT in ${BOOT_ORDER}; do
    if test "x${rauc_slot}" != "x"; then
        true
    elif test "x${BOOT_SLOT}" = "xA"; then
        if test ${BOOT_A_LEFT} -gt 0; then
            echo "Found valid RAUC slot A (${BOOT_A_LEFT} attempts left)"
            setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1
            setenv rauc_slot "A"
            setenv fit_part 2
            setenv root_part "/dev/mmcblk0p5"
        fi
    elif test "x${BOOT_SLOT}" = "xB"; then
        if test ${BOOT_B_LEFT} -gt 0; then
            echo "Found valid RAUC slot B (${BOOT_B_LEFT} attempts left)"
            setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1
            setenv rauc_slot "B"
            setenv fit_part 3
            setenv root_part "/dev/mmcblk0p6"
        fi
    fi
done

if test -z "${rauc_slot}"; then
    echo "No valid RAUC slot found! Resetting boot attempts to 3 and rebooting..."
    setenv BOOT_A_LEFT 3
    setenv BOOT_B_LEFT 3
    saveenv
    reset
fi

# Persist decremented boot attempt counter before booting
saveenv

setenv bootargs "${bootargs} root=${root_part} rauc.slot=${rauc_slot}"

# Load raw FIT image from fita/fitb to 0x06000000 (96 MiB):
# clear of kernel_addr_r (0x00080000), kernel_comp_addr_r (0x02000000-0x05400000),
# scriptaddr (0x05400000), fdt_addr_r (0x05600000), and ramdisk_addr_r (0x05700000).
setenv fit_addr 0x06000000
setenv load_ok 0
if @@BOOT_MEDIA@@ dev 0; then
    if part start @@BOOT_MEDIA@@ 0 ${fit_part} fit_start; then
        if part size @@BOOT_MEDIA@@ 0 ${fit_part} fit_size; then
            if @@BOOT_MEDIA@@ read ${fit_addr} ${fit_start} ${fit_size}; then
                setenv load_ok 1
            fi
        fi
    fi
fi

if test "${load_ok}" = "1"; then
    # Arm BCM2835 hardware watchdog (15s max) so early kernel hangs reset and trigger RAUC fallback
    wdt dev watchdog@7e100000 && wdt start 15000
    bootm ${fit_addr}@@FIT_BOOT_CONFIG@@
fi

echo "ERROR: Failed to boot RAUC slot ${rauc_slot}! Resetting..."
reset

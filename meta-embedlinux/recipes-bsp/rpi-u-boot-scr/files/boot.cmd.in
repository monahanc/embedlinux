# Read base kernel command line provided by RPi GPU firmware (from cmdline.txt)
fdt addr ${fdt_addr} && fdt get value bootargs /chosen bootargs

# Initialize A/B boot state defaults if unset
if test -z "${slot}"; then
    setenv slot a
fi
if test -z "${upgrade_available}"; then
    setenv upgrade_available 0
fi
if test -z "${bootcount}"; then
    setenv bootcount 0
fi
if test -z "${bootlimit}"; then
    setenv bootlimit 3
fi

# Persist initial U-Boot environment on boot partition for fw_printenv/fw_setenv
if test ! -e @@BOOT_MEDIA@@ 0:1 uboot.env; then
    saveenv
fi

# Automatic A/B fallback state machine:
# When upgrade_available=1, track boot attempts; if bootcount reaches bootlimit
# without userspace confirming the boot, roll back to the previous slot.
if test "${upgrade_available}" = "1"; then
    if test ${bootcount} -ge ${bootlimit}; then
        echo "Boot limit (${bootlimit}) reached on slot ${slot}! Rolling back..."
        if test "${slot}" = "b"; then
            setenv slot a
        else
            setenv slot b
        fi
        setenv upgrade_available 0
        setenv bootcount 0
        saveenv
        echo "Rolled back to slot ${slot}"
    else
        setexpr bootcount ${bootcount} + 1
        saveenv
        echo "Unconfirmed slot ${slot}: boot attempt ${bootcount}/${bootlimit}"
    fi
fi

# Select FIT and rootfs partitions for active slot
# MBR partition layout:
#   p1: boot  (vfat)
#   p2: fita  (raw FIT image)
#   p3: fitb  (raw FIT image)
#   p4: extended partition container
#   p5: roota (ext4)
#   p6: rootb (ext4)
#   p7: data  (ext4)
if test "${slot}" = "b"; then
    echo "Booting slot B (fitb=p3, rootb=p6)..."
    setenv fit_part 3
    setenv root_part /dev/mmcblk0p6
else
    echo "Booting slot A (fita=p2, roota=p5)..."
    setenv fit_part 2
    setenv root_part /dev/mmcblk0p5
fi

setenv bootargs "${bootargs} root=${root_part}"

# Load raw FIT image from fita/fitb to 0x06000000 (96 MiB):
# clear of kernel_addr_r (0x00080000), kernel_comp_addr_r (0x02000000-0x05400000),
# scriptaddr (0x05400000), fdt_addr_r (0x05600000), and ramdisk_addr_r (0x05700000).
setenv fit_addr 0x06000000
setenv load_ok 0
if @@BOOT_MEDIA@@ dev 0; then
    if part start @@BOOT_MEDIA@@ 0 ${fit_part} fit_start; then
        if part size @@BOOT_MEDIA@@ 0 ${fit_part} fit_size; then
            if @@BOOT_MEDIA@@ read ${fit_addr} ${fit_start} ${fit_size}; then
                setenv load_ok 1
            fi
        fi
    fi
fi

if test "${load_ok}" = "1"; then
    # Arm BCM2835 hardware watchdog (15s max) during unconfirmed boots so a
    # silent early-kernel hang forces a reset and triggers fallback.
    if test "${upgrade_available}" = "1"; then
        wdt dev watchdog@7e100000 && wdt start 15000
    fi
    bootm ${fit_addr}@@FIT_BOOT_CONFIG@@
fi

echo "ERROR: Failed to boot slot ${slot}!"
if test "${upgrade_available}" = "1"; then
    echo "Resetting to retry/rollback..."
    reset
fi
